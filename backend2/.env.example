# App
APP_NAME=rag-enterprise
APP_ENV=development
API_PREFIX=/api/v1
# Prefer Postgres via docker compose; SQLite works for smoke without Docker
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag
# DATABASE_URL=sqlite:///./rag.db

# Redis (retrieval cache + optional rate-limit keys)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Qdrant (vectors owned by 后端1 ingest; this service only retrieves)
# NOTE: 后端1 local demo uses QDRANT_PATH=./data/qdrant-b1 (not shared HTTP :6333).
# Prefer RETRIEVAL_BACKEND=backend1 so 后端2 calls 后端1 /retrieve instead of opening that path.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sdnu_chunks
# Local path mode when Docker unavailable (do NOT share 后端1's qdrant-b1 path concurrently)
# QDRANT_PATH=./data/qdrant

# Retrieval routing
RETRIEVAL_BACKEND=backend1
BACKEND1_BASE_URL=http://127.0.0.1:8001

# OpenAI-compatible LLM (ChatOpenAI) — local Ollama example
# Empty OPENAI_API_KEY is treated as sk-no-auth for local Ollama / OpenAI-compat proxies
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:3b

# Embeddings used for query vectors (must match 后端1 ingest model)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT auth (后端2) — MUST match 后端1 JWT_SECRET so tokens verify on :8001 retrieve
# Demo shared secret (same as 后端1 .env.example): change-me-to-a-long-random-string
# Claims: sub=user_id, tenant_id; Header: Authorization: Bearer <token>
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG
RAG_TOP_K=5
