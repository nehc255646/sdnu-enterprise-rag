# App
APP_NAME=rag-enterprise
APP_ENV=development
API_PREFIX=/api/v1
# Prefer Postgres via docker compose; SQLite works for smoke without Docker
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag
# DATABASE_URL=sqlite:///./rag.db

# Redis (retrieval cache + optional rate-limit keys)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Qdrant (vectors owned by 后端1 ingest; this service only retrieves)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sdnu_chunks
# Local path mode when Docker unavailable
# QDRANT_PATH=./data/qdrant

# OpenAI-compatible LLM (ChatOpenAI)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embeddings used for query vectors (must match 后端1 ingest model)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# JWT auth (后端2) — share JWT_SECRET / JWT_ALGORITHM with 后端1 (see docs/jwt-handoff.md)
# Claims: sub=user_id, tenant_id; Header: Authorization: Bearer <token>
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG
RAG_TOP_K=5
