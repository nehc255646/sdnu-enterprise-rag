# App
APP_NAME=rag-backend1
APP_ENV=development
API_PREFIX=/api/v1

# Database (Postgres in compose; SQLite ok for local smoke without Docker)
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag
# DATABASE_URL=sqlite:///./rag.db

# Redis
REDIS_URL=redis://localhost:6379/0
INGEST_QUEUE_KEY=rag:ingest:jobs

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sdnu_chunks
# Local path mode when Docker unavailable (mutually exclusive with URL for local file store)
# QDRANT_PATH=./data/qdrant-b1

# Embeddings: openai | huggingface | hash
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ingest
CHUNK_SIZE=320
CHUNK_OVERLAP=48
UPLOAD_DIR=./data/uploads
