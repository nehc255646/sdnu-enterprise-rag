# App
APP_NAME=sdnu-rag
APP_ENV=development
API_PREFIX=/api/v1

# Database (Postgres in compose; SQLite ok for local smoke without Docker)
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag
# DATABASE_URL=sqlite:///./rag.db

# Redis (ingest queue, retrieve cache, rate limit)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
INGEST_QUEUE_KEY=rag:ingest:jobs

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sdnu_chunks
# Local path mode when Docker unavailable (mutually exclusive with URL)
# QDRANT_PATH=./data/qdrant

# Embeddings: ollama | openai | huggingface | hash
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI-compatible chat LLM (local Ollama /v1 by default)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_MODEL=qwen2.5:1.5b

# Ingest
CHUNK_SIZE=320
CHUNK_OVERLAP=48
UPLOAD_DIR=./data/uploads

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG
RAG_TOP_K=5

# Chat rate limit (Redis-backed; Redis down → process-local, never 500)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=60
